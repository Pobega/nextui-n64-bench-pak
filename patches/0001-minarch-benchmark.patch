+void Bench_onFrameBegin(void) {
+	if (!bench.active) return;
+
+	bench.frame_got_video = 0;
+	bench.frame_was_new = 0;
+	bench.frame_did_uncapped_flip = 0;
+	bench.frame_input_seen = 0;
+	bench.frame_buttons = bench.polled_buttons;
+	bench.frame_lx = bench.polled_lx;
+	bench.frame_ly = bench.polled_ly;
+	bench.frame_rx = bench.polled_rx;
+	bench.frame_ry = bench.polled_ry;
+	bench.frame_start_us = getMicroseconds();
+
+	if (bench.uncapped) {
+		fast_forward = 1;
+	}
+}
