+
+int State_writePath(const char* filename) {
+	if (!filename || !filename[0]) return 0;
+
+	int success = 0;
+	size_t state_size = core.serialize_size();
+	if (!state_size) return 0;
+
+	int was_ff = fast_forward;
+	fast_forward = 0;
+
+	void *state = calloc(1, state_size);
+	FILE *state_file = NULL;
+	char *tmp_path = NULL;
+	if (!state) {
+		LOG_error("Couldn't allocate memory for state\n");
+		goto error;
+	}
+
+	if (!core.serialize(state, state_size)) {
+		LOG_error("Error serializing save state\n");
+		goto error;
+	}
+
+	size_t flen = strlen(filename);
+	tmp_path = malloc(flen + 5);
+	if (!tmp_path) {
+		LOG_error("Couldn't allocate memory for temp state path\n");
+		goto error;
+	}
+	snprintf(tmp_path, flen + 5, "%s.tmp", filename);
+
+	state_file = fopen(tmp_path, "wb");
+	if (!state_file) {
+		LOG_error("Error opening temp state file: %s (%s)\n", tmp_path, strerror(errno));
+		goto error;
+	}
+	if (state_size != fwrite(state, 1, state_size, state_file)) {
+		LOG_error("Error writing state data to file: %s (%s)\n", tmp_path, strerror(errno));
+		goto error;
+	}
+	if (fflush(state_file) != 0) {
+		LOG_error("Error flushing state file: %s (%s)\n", tmp_path, strerror(errno));
+		goto error;
+	}
+	fclose(state_file);
+	state_file = NULL;
+
+	if (rename(tmp_path, filename) != 0) {
+		LOG_error("Error renaming state file %s -> %s (%s)\n", tmp_path, filename, strerror(errno));
+		goto error;
+	}
+	sync();
+	success = 1;
+
+error:
+	if (state_file) fclose(state_file);
+	if (!success && tmp_path) remove(tmp_path);
+	free(tmp_path);
+	free(state);
+	fast_forward = was_ff;
+	return success;
+}
