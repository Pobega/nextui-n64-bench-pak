+void Bench_onInputPolled(uint32_t btn_mask, int16_t lx, int16_t ly, int16_t rx, int16_t ry) {
+	if (!bench.active || !bench.recording) return;
+	bench.polled_buttons = btn_mask;
+	bench.polled_lx = lx;
+	bench.polled_ly = ly;
+	bench.polled_rx = rx;
+	bench.polled_ry = ry;
+}
+
+void Bench_onInputRead(uint32_t btn_mask, int16_t lx, int16_t ly, int16_t rx, int16_t ry) {
+	if (!bench.active || !bench.recording || bench.phase != BENCH_PHASE_RECORD) return;
+	bench.frame_buttons = btn_mask;
+	bench.frame_lx = lx;
+	bench.frame_ly = ly;
+	bench.frame_rx = rx;
+	bench.frame_ry = ry;
+	bench.frame_input_seen = 1;
+}
+
+int Bench_getScriptedInput(unsigned port, unsigned device, unsigned index, unsigned id, int16_t *out_value) {
+	if (!bench.active || !out_value) return 0;
+	if ((bench.recording || bench.config_mode) && bench.phase == BENCH_PHASE_RECORD) {
+		return 0;
+	}
+	if (port != 0) {
+		*out_value = 0;
+		return 1;
+	}
+
+	uint32_t btn_mask = 0;
+	int16_t lx = 0;
+	int16_t ly = 0;
+	int16_t rx = 0;
+	int16_t ry = 0;
+
+	if (!bench.recording && !bench.config_mode && bench.phase == BENCH_PHASE_RECORD) {
+		for (size_t i = 0; i < bench.input_count; i++) {
+			const BenchInputStep *step = &bench.inputs[i];
+			if (bench.script_frame >= step->start_frame && bench.script_frame < step->end_frame) {
+				btn_mask |= step->buttons;
+				lx = step->lx;
+				ly = step->ly;
+				rx = step->rx;
+				ry = step->ry;
+			}
+		}
+	}
+
+	if (device == RETRO_DEVICE_JOYPAD && index == 0) {
+		*out_value = (id == RETRO_DEVICE_ID_JOYPAD_MASK)
+			? (int16_t)btn_mask
+			: (int16_t)((btn_mask >> id) & 1);
+		return 1;
+	}
+	if (device == RETRO_DEVICE_ANALOG && index == RETRO_DEVICE_INDEX_ANALOG_LEFT) {
+		if (id == RETRO_DEVICE_ID_ANALOG_X) { *out_value = lx; return 1; }
+		if (id == RETRO_DEVICE_ID_ANALOG_Y) { *out_value = ly; return 1; }
+	}
+	if (device == RETRO_DEVICE_ANALOG && index == RETRO_DEVICE_INDEX_ANALOG_RIGHT) {
+		if (id == RETRO_DEVICE_ID_ANALOG_X) { *out_value = rx; return 1; }
+		if (id == RETRO_DEVICE_ID_ANALOG_Y) { *out_value = ry; return 1; }
+	}
+	*out_value = 0;
+	return 1;
+}
+
+int Bench_checkAbortInput(void) {
+	if (!bench.active || bench.config_mode) return 0;
+	if (PAD_isPressed(BTN_MENU)) {
+		uint32_t now_ms = SDL_GetTicks();
+		if (bench.menu_hold_start_ms == 0) {
+			bench.menu_hold_start_ms = now_ms;
+		}
+		else if ((now_ms - bench.menu_hold_start_ms) >= BENCH_ABORT_HOLD_MS) {
+			LOG_info("Bench: stopped by user (MENU hold)\n");
+			bench.aborted = 1;
+			bench.record_end_us = getMicroseconds();
+			bench.temp_end_c = bench_read_soc_temp_c();
+			bench.phase = BENCH_PHASE_DONE;
+			quit = 1;
+			return 1;
+		}
+	}
+	else {
+		bench.menu_hold_start_ms = 0;
+	}
+
+	if (bench.genstate && bench.capture_frame == 0) {
+		int want_ff = PAD_isPressed(BTN_R1) ? 1 : 0;
+		if (want_ff != bench.uncapped) {
+			bench.uncapped = want_ff;
+			fast_forward = want_ff;
+			bench.last_uncapped_flip_ms = 0;
+			bench.last_hud_ms = 0;
+		}
+		if (PAD_justPressed(BTN_A) && bench.boot_frame >= BENCH_GENSTATE_MIN_INTERACT_F) {
+			bench.capture_requested = 1;
+		}
+	}
+
+	return bench.recording ? 0 : 1;
+}
+
+void Bench_finish(void) {
+	if (!bench.active) return;
+
+	if (bench.record_end_us == 0 && bench.record_start_us > 0) {
+		bench.record_end_us = getMicroseconds();
+		bench.temp_end_c = bench_read_soc_temp_c();
+	}
+	if (bench.recording) {
+		bench_write_recording();
+	}
+	else if (!bench.config_mode && !bench.genstate) {
+		bench_write_outputs();
+	}
+
+	PLAT_clearNotificationSurface();
+	if (bench.hud_surface) {
+		SDL_FreeSurface(bench.hud_surface);
+		bench.hud_surface = NULL;
+	}
+	if (bench.samples) {
+		free(bench.samples);
+		bench.samples = NULL;
+	}
+	if (bench.inputs) {
+		free(bench.inputs);
+		bench.inputs = NULL;
+	}
+	if (bench.rec_steps) {
+		free(bench.rec_steps);
+		bench.rec_steps = NULL;
