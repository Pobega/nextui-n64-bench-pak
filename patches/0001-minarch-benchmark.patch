+int Bench_getExitCode(void) {
+	if (!bench.active) return BENCH_EXIT_OK;
+	if (bench.state_failed) return BENCH_EXIT_STATE_FAIL;
+	if (bench.config_mode) return BENCH_EXIT_OK;
+	if (bench.aborted) return BENCH_EXIT_ABORTED;
+	if (bench.genstate) {
+		return bench.genstate_saved ? BENCH_EXIT_OK : BENCH_EXIT_ABORTED;
+	}
+	if (bench.recording) {
+		return (bench.script_frame >= BENCH_MIN_RECORD_FRAMES) ? BENCH_EXIT_OK : BENCH_EXIT_ABORTED;
+	}
+	return BENCH_EXIT_OK;
+}
