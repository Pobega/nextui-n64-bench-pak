+static void bench_write_outputs(void) {
+	double elapsed_s = (bench.record_end_us > bench.record_start_us)
+		? (double)(bench.record_end_us - bench.record_start_us) / 1e6
+		: 0.0;
+
+	double *sorted = NULL;
+	double ms_avg = 0.0, ms_p50 = 0.0, ms_p95 = 0.0, ms_p99 = 0.0, ms_max = 0.0;
+	double fps_1pct = 0.0, fps_01pct = 0.0;
+
+	if (bench.sample_count > 0) {
+		sorted = malloc(bench.sample_count * sizeof(double));
+		if (sorted) {
+			double sum = 0.0;
+			for (size_t i = 0; i < bench.sample_count; i++) {
+				sorted[i] = bench.samples[i].frame_ms;
+				sum += sorted[i];
+			}
+			qsort(sorted, bench.sample_count, sizeof(double), bench_compare_double);
+			ms_avg = sum / (double)bench.sample_count;
+			ms_p50 = bench_percentile(sorted, bench.sample_count, 50.0);
+			ms_p95 = bench_percentile(sorted, bench.sample_count, 95.0);
+			ms_p99 = bench_percentile(sorted, bench.sample_count, 99.0);
+			ms_max = sorted[bench.sample_count - 1];
+			fps_1pct = bench_low_fps(sorted, bench.sample_count, 0.01);
+			fps_01pct = bench_low_fps(sorted, bench.sample_count, 0.001);
+			free(sorted);
+		}
+	}
+
+	double vi_fps = elapsed_s > 0.0 ? (double)bench.vi_frames / elapsed_s : 0.0;
+	double ren_fps = elapsed_s > 0.0 ? (double)bench.rendered_frames / elapsed_s : 0.0;
+	double target_fps = core.fps > 1.0 ? core.fps : 60.0;
+	double speed_pct = (vi_fps / target_fps) * 100.0;
+
+	if (bench.out_csv_path && bench.out_csv_path[0] && bench.sample_count > 0) {
+		FILE *csv = fopen(bench.out_csv_path, "w");
+		if (csv) {
+			fprintf(csv, "vi_index,frame_ms,was_new_frame\n");
+			for (size_t i = 0; i < bench.sample_count; i++) {
+				fprintf(csv, "%zu,%.3f,%u\n",
+					i, bench.samples[i].frame_ms, (unsigned)bench.samples[i].was_new_frame);
+			}
+			fclose(csv);
+		}
+	}
+
+	if (bench.out_json_path && bench.out_json_path[0]) {
+		FILE *js = fopen(bench.out_json_path, "w");
+		if (js) {
+			fprintf(js, "{\n");
+			fprintf(js, "  \"mode\": \"%s\",\n", bench.uncapped ? "uncapped" : "paced");
+			fprintf(js, "  \"status\": \"%s\",\n",
+				bench.aborted ? "aborted" : (bench.state_failed ? "state_failed" : "ok"));
+			fprintf(js, "  \"gl_renderer\": ");
+			bench_write_json_str(js, bench.gl_renderer[0] ? bench.gl_renderer : "unknown");
+			fprintf(js, ",\n");
+			fprintf(js, "  \"gl_version\": ");
+			bench_write_json_str(js, bench.gl_version[0] ? bench.gl_version : "unknown");
+			fprintf(js, ",\n");
+			fprintf(js, "  \"elapsed_sec\": %.4f,\n", elapsed_s);
+			fprintf(js, "  \"core_fps\": %.4f,\n", target_fps);
+			fprintf(js, "  \"width\": %u,\n", bench.last_width);
+			fprintf(js, "  \"height\": %u,\n", bench.last_height);
+			fprintf(js, "  \"vi_frames\": %u,\n", bench.vi_frames);
+			fprintf(js, "  \"rendered_frames\": %u,\n", bench.rendered_frames);
+			fprintf(js, "  \"duplicate_frames\": %u,\n", bench.duplicate_frames);
+			fprintf(js, "  \"skipped_frames\": %u,\n", bench.skipped_frames);
+			fprintf(js, "  \"vi_fps_avg\": %.3f,\n", vi_fps);
+			fprintf(js, "  \"rendered_fps_avg\": %.3f,\n", ren_fps);
+			fprintf(js, "  \"speed_pct\": %.2f,\n", speed_pct);
+			fprintf(js, "  \"frame_ms_avg\": %.3f,\n", ms_avg);
+			fprintf(js, "  \"frame_ms_p50\": %.3f,\n", ms_p50);
+			fprintf(js, "  \"frame_ms_p95\": %.3f,\n", ms_p95);
+			fprintf(js, "  \"frame_ms_p99\": %.3f,\n", ms_p99);
+			fprintf(js, "  \"frame_ms_max\": %.3f,\n", ms_max);
+			fprintf(js, "  \"fps_1pct_low\": %.3f,\n", fps_1pct);
+			fprintf(js, "  \"fps_01pct_low\": %.3f,\n", fps_01pct);
+			fprintf(js, "  \"missed_vsyncs\": %u,\n", bench.missed_vsyncs);
+			fprintf(js, "  \"audio_underruns\": %u,\n", bench.audio_underruns);
+			fprintf(js, "  \"soc_temp_start_c\": %.2f,\n", bench.temp_start_c);
+			fprintf(js, "  \"soc_temp_end_c\": %.2f\n", bench.temp_end_c);
+			fprintf(js, "}\n");
+			fclose(js);
+		}
+	}
+
+	LOG_info("Bench DONE [%s]: vi=%.2f fps, 3d=%.2f fps (%.1f%%), avg=%.2fms, p99=%.2fms, 1%%low=%.2f\n",
+		bench.uncapped ? "uncapped" : "paced", vi_fps, ren_fps, speed_pct, ms_avg, ms_p99, fps_1pct);
+}
+
+static void bench_record_frame_input(uint32_t frame_idx) {
+	if (bench.rec_count > 0) {
+		BenchInputStep *last = &bench.rec_steps[bench.rec_count - 1];
+		if (last->end_frame == frame_idx &&
+		    last->buttons == bench.frame_buttons &&
+		    last->lx == bench.frame_lx &&
+		    last->ly == bench.frame_ly &&
+		    last->rx == bench.frame_rx &&
+		    last->ry == bench.frame_ry) {
+			last->end_frame = frame_idx + 1;
+			return;
+		}
+	}
+	BenchInputStep step = {
+		.start_frame = frame_idx,
+		.end_frame = frame_idx + 1,
+		.lx = bench.frame_lx,
+		.ly = bench.frame_ly,
+		.rx = bench.frame_rx,
+		.ry = bench.frame_ry,
+		.buttons = bench.frame_buttons
+	};
+	bench_append_step(&bench.rec_steps, &bench.rec_count, &bench.rec_cap, &step);
+}
+
+static void bench_write_recording(void) {
+	if (!bench.recording || bench.state_failed) return;
+	if (!bench.out_input_path || !bench.out_input_path[0]) return;
+	if (bench.script_frame < BENCH_MIN_RECORD_FRAMES) {
+		LOG_info("Bench REC: discarded short recording (%u frames < %d)\n",
+			bench.script_frame, BENCH_MIN_RECORD_FRAMES);
+		return;
+	}
+
+	size_t path_len = strlen(bench.out_input_path);
+	char *tmp_path = malloc(path_len + 5);
+	if (!tmp_path) return;
+	memcpy(tmp_path, bench.out_input_path, path_len);
+	memcpy(tmp_path + path_len, ".tmp", 5);
+
+	FILE *fp = fopen(tmp_path, "w");
+	if (!fp) {
+		LOG_error("Bench REC: failed to open %s for writing\n", tmp_path);
+		free(tmp_path);
+		return;
+	}
+	fprintf(fp, "# N64Bench input recording v1\n");
+	fprintf(fp, "# frames=%u steps=%zu\n", bench.script_frame, bench.rec_count);
+	for (size_t i = 0; i < bench.rec_count; i++) {
+		const BenchInputStep *st = &bench.rec_steps[i];
+		fprintf(fp, "%u %u %d %d %u %d %d\n",
+			st->start_frame, st->end_frame,
+			(int)st->lx, (int)st->ly, st->buttons,
+			(int)st->rx, (int)st->ry);
+	}
+	if (fclose(fp) != 0 || rename(tmp_path, bench.out_input_path) != 0) {
+		LOG_error("Bench REC: failed to finalize %s\n", bench.out_input_path);
+		remove(tmp_path);
+	}
+	else {
+		LOG_info("Bench REC: saved %u frames (%zu steps) to %s\n",
+			bench.script_frame, bench.rec_count, bench.out_input_path);
+	}
+	free(tmp_path);
+}
+
+static void bench_save_genstate(void) {
+	if (!bench.out_state_path || !bench.out_state_path[0]) {
+		LOG_error("Bench GENSTATE: missing BENCH_OUT_STATE\n");
+		bench.state_failed = 1;
+		bench.phase = BENCH_PHASE_DONE;
+		quit = 1;
+		return;
+	}
+	if (!State_writePath(bench.out_state_path)) {
+		LOG_error("Bench GENSTATE: failed writing %s\n", bench.out_state_path);
+		bench.state_failed = 1;
+		bench.phase = BENCH_PHASE_DONE;
+		quit = 1;
+		return;
+	}
+	if (bench.out_meta_path && bench.out_meta_path[0]) {
+		FILE *mfp = fopen(bench.out_meta_path, "w");
+		if (mfp) {
+			fprintf(mfp, "CAPTURE_FRAME=%u\n", bench.boot_frame);
+			fclose(mfp);
+		}
+	}
+	bench.genstate_saved = 1;
+	bench.phase = BENCH_PHASE_DONE;
+	quit = 1;
+	LOG_info("Bench GENSTATE: saved %s at frame %u\n", bench.out_state_path, bench.boot_frame);
+}
+
+void Bench_initFromEnv(void) {
+	memset(&bench, 0, sizeof(bench));
+	const char *en = getenv("BENCH_ENABLE");
+	if (!en || strcmp(en, "1") != 0) return;
+
+	bench.active = 1;
+	const char *mode = getenv("BENCH_MODE");
+	bench.config_mode = (mode && strcmp(mode, "config") == 0) ? 1 : 0;
+	bench.genstate = (!bench.config_mode && mode && strcmp(mode, "genstate") == 0) ? 1 : 0;
+	bench.recording = (!bench.config_mode && !bench.genstate && mode && strcmp(mode, "record") == 0) ? 1 : 0;
+	bench.capture_frame = bench.genstate ? bench_read_env_u32("BENCH_CAPTURE_FRAME", 0) : 0;
+	bench.uncapped = (bench.genstate && bench.capture_frame > 0)
+		? 1
+		: ((!bench.config_mode && !bench.recording && !bench.genstate && mode && strcmp(mode, "uncapped") == 0) ? 1 : 0);
+	const char *d2a = getenv("BENCH_DPAD_TO_ANALOG");
+	bench.dpad_to_analog = (d2a && strcmp(d2a, "1") == 0) ? 1 : 0;
+
+	bench.cfg_path = getenv("BENCH_CFG_PATH");
+	bench.state_path = getenv("BENCH_STATE_PATH");
+	bench.input_path = getenv("BENCH_INPUT_FILE");
+	bench.out_input_path = getenv("BENCH_OUT_INPUT");
+	bench.out_state_path = getenv("BENCH_OUT_STATE");
+	bench.out_meta_path = getenv("BENCH_OUT_META");
+	bench.out_json_path = getenv("BENCH_OUT_JSON");
+	bench.out_csv_path = getenv("BENCH_OUT_CSV");
+	bench.label = getenv("BENCH_LABEL");
+
+	int default_dur = bench.recording
+		? BENCH_DEFAULT_RECORD_SEC
+		: (bench.uncapped ? BENCH_DEFAULT_UNCAPPED_SEC : BENCH_DEFAULT_PACED_SEC);
+	bench.warmup_frames = (uint32_t)bench_read_env_int("BENCH_WARMUP_FRAMES", BENCH_DEFAULT_WARMUP);
+	bench.duration_sec = (double)bench_read_env_int("BENCH_DURATION_SEC", default_dur);
+	bench.phase = bench.genstate ? BENCH_PHASE_RECORD : BENCH_PHASE_BOOT;
+	if (bench.genstate) {
+		bench.record_start_us = getMicroseconds();
+	}
+	bench.temp_start_c = -1.0;
+	bench.temp_end_c = -1.0;
+	snprintf(bench.gl_renderer, sizeof(bench.gl_renderer), "unknown");
+	snprintf(bench.gl_version, sizeof(bench.gl_version), "unknown");
+
+	if (!bench.recording && !bench.config_mode) {
+		bench_load_inputs(bench.input_path);
+	}
+
+	if (bench.uncapped) {
+		fast_forward = 1;
+	}
+
+	LOG_info("Bench initialized: mode=%s capture_frame=%u dpad_to_analog=%d warmup=%u duration=%.0fs state=%s\n",
+		bench.genstate ? "genstate" : (bench.config_mode ? "config" : (bench.recording ? "record" : (bench.uncapped ? "uncapped" : "paced"))),
+		bench.capture_frame,
+		bench.dpad_to_analog,
+		bench.warmup_frames, bench.duration_sec,
+		bench.state_path ? bench.state_path : "(none)");
+}
