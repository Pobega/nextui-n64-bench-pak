+static void bench_capture_gl_info(void) {
+	if (bench.gl_captured) return;
+	PLAT_HWR_makeCurrent();
+	const char *r = (const char *)glGetString(GL_RENDERER);
+	const char *v = (const char *)glGetString(GL_VERSION);
+	if (r && r[0]) {
+		snprintf(bench.gl_renderer, sizeof(bench.gl_renderer), "%s", r);
+		bench.gl_captured = 1;
+	}
+	if (v && v[0]) {
+		snprintf(bench.gl_version, sizeof(bench.gl_version), "%s", v);
+		bench.gl_captured = 1;
+	}
+}
