+void Bench_onVideoFrame(int is_new_frame, unsigned width, unsigned height) {
+	if (!bench.active) return;
+	bench_capture_gl_info();
+	bench.frame_got_video = 1;
+	if (is_new_frame) bench.frame_was_new = 1;
