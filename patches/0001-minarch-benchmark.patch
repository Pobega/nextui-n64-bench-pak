+static int bench_read_env_int(const char *name, int fallback) {
+	const char *val = getenv(name);
+	if (!val || !val[0]) return fallback;
+	int parsed = atoi(val);
+	return parsed > 0 ? parsed : fallback;
+}
+
+static uint32_t bench_read_env_u32(const char *name, uint32_t fallback) {
+	const char *val = getenv(name);
+	if (!val || !val[0]) return fallback;
+	char *end = NULL;
+	unsigned long parsed = strtoul(val, &end, 10);
+	if (end == val || *end != '\0') return fallback;
+	return (uint32_t)parsed;
+}
+
+static double bench_read_soc_temp_c(void) {
+	FILE *fp = fopen(BENCH_THERMAL_PATH, "r");
+	if (!fp) return -1.0;
+	long raw = 0;
+	int ok = (fscanf(fp, "%ld", &raw) == 1);
+	fclose(fp);
+	if (!ok) return -1.0;
+	return raw > 1000 ? (double)raw / 1000.0 : (double)raw;
+}
+
+static int bench_append_step(BenchInputStep **arr, size_t *count, size_t *cap, const BenchInputStep *step) {
+	if (*count >= *cap) {
+		size_t next_cap = (*cap) ? (*cap * 2) : BENCH_INITIAL_INPUT_CAP;
+		BenchInputStep *grown = realloc(*arr, next_cap * sizeof(BenchInputStep));
+		if (!grown) return 0;
+		*arr = grown;
+		*cap = next_cap;
+	}
+	(*arr)[(*count)++] = *step;
+	return 1;
+}
+
+static void bench_load_inputs(const char *path) {
+	bench.input_count = 0;
+	if (!path || !path[0]) return;
+	FILE *fp = fopen(path, "r");
+	if (!fp) {
+		LOG_warn("Bench: could not open input script %s\n", path);
+		return;
+	}
+	char line[512];
+	while (fgets(line, sizeof(line), fp)) {
+		const char *p = line;
+		while (*p == ' ' || *p == '\t') p++;
+		if (*p == '#' || *p == '\n' || *p == '\r' || *p == '\0') continue;
+		unsigned int start_f = 0, end_f = 0, btn_mask = 0;
+		int lx = 0, ly = 0, rx = 0, ry = 0;
+		int parsed = sscanf(p, "%u %u %d %d %u %d %d", &start_f, &end_f, &lx, &ly, &btn_mask, &rx, &ry);
+		if (parsed == 7 || parsed == 5) {
+			if (parsed == 5) {
+				rx = 0;
+				ry = 0;
+			}
+			BenchInputStep step = {
+				.start_frame = start_f,
+				.end_frame = end_f,
+				.lx = (int16_t)lx,
+				.ly = (int16_t)ly,
+				.rx = (int16_t)rx,
+				.ry = (int16_t)ry,
+				.buttons = btn_mask
+			};
+			if (!bench_append_step(&bench.inputs, &bench.input_count, &bench.input_cap, &step)) {
+				break;
+			}
+		}
+	}
+	fclose(fp);
+	LOG_info("Bench: loaded %zu scripted input steps from %s\n", bench.input_count, path);
+}
+
+static void bench_append_sample(double frame_ms, int was_new_frame) {
+	if (bench.sample_count >= bench.sample_cap) {
+		size_t next_cap = bench.sample_cap ? bench.sample_cap * 2 : BENCH_INITIAL_FRAME_CAP;
+		BenchFrameSample *grown = realloc(bench.samples, next_cap * sizeof(BenchFrameSample));
+		if (!grown) return;
+		bench.samples = grown;
+		bench.sample_cap = next_cap;
+	}
+	bench.samples[bench.sample_count].frame_ms = frame_ms;
+	bench.samples[bench.sample_count].was_new_frame = was_new_frame ? 1 : 0;
+	bench.sample_count++;
+}
+
+static int bench_compare_double(const void *a, const void *b) {
+	double da = *(const double *)a;
+	double db = *(const double *)b;
+	return (da > db) - (da < db);
+}
+
+static double bench_percentile(const double *sorted, size_t n, double p) {
+	if (n == 0) return 0.0;
+	double idx = (p / 100.0) * (double)(n - 1);
+	size_t lo = (size_t)idx;
+	size_t hi = (lo + 1 < n) ? lo + 1 : lo;
+	double frac = idx - (double)lo;
+	return sorted[lo] * (1.0 - frac) + sorted[hi] * frac;
+}
+
+static double bench_low_fps(const double *sorted, size_t n, double worst_fraction) {
+	if (n == 0) return 0.0;
+	size_t tail_count = (size_t)ceil((double)n * worst_fraction);
+	if (tail_count < 1) tail_count = 1;
+	if (tail_count > n) tail_count = n;
+	double sum_ms = 0.0;
+	for (size_t i = n - tail_count; i < n; i++) {
+		sum_ms += sorted[i];
+	}
+	double avg_tail_ms = sum_ms / (double)tail_count;
+	return avg_tail_ms > 0.001 ? 1000.0 / avg_tail_ms : 0.0;
+}
+
+static void bench_blit_text(SDL_Surface *dst, TTF_Font *ttf, const char *text, int x, int y, SDL_Color color) {
+	if (!dst || !ttf || !text || !text[0]) return;
+	SDL_Surface *surf = TTF_RenderUTF8_Blended(ttf, text, color);
+	if (!surf) return;
+	SDL_Rect rc = { x, y, surf->w, surf->h };
+	SDL_BlitSurface(surf, NULL, dst, &rc);
+	SDL_FreeSurface(surf);
+}
+
+static void bench_render_hud(void) {
+	if (!screen || !font.tiny) return;
+	uint32_t now_ms = SDL_GetTicks();
+	uint32_t hud_interval = (bench.genstate && bench.capture_frame == 0)
+		? BENCH_GENSTATE_HUD_MS
+		: BENCH_HUD_INTERVAL_MS;
+	if (bench.last_hud_ms != 0 && (now_ms - bench.last_hud_ms) < hud_interval) return;
+	bench.last_hud_ms = now_ms;
+
+	if (bench.config_mode && bench.phase == BENCH_PHASE_RECORD) {
+		double elapsed_s = (double)(getMicroseconds() - bench.record_start_us) / 1e6;
+		if (elapsed_s >= BENCH_CONFIG_HUD_SEC) {
+			if (!bench.config_hud_cleared) {
+				PLAT_clearNotificationSurface();
+				bench.config_hud_cleared = 1;
+			}
+			return;
+		}
+	}
+
+	int sw = screen->w > 0 ? screen->w : 640;
+	int sh = screen->h > 0 ? screen->h : 480;
+	int bar_h = SCALE1(BENCH_HUD_BAR_BASE_H);
+	if (bar_h < BENCH_HUD_BAR_MIN_H) bar_h = BENCH_HUD_BAR_MIN_H;
+	if (bar_h > sh / 6) bar_h = sh / 6;
+
+	if (!bench.hud_surface || bench.hud_surface->w != sw || bench.hud_surface->h != sh) {
+		if (bench.hud_surface) SDL_FreeSurface(bench.hud_surface);
+		bench.hud_surface = SDL_CreateRGBSurfaceWithFormat(0, sw, sh, 32, SDL_PIXELFORMAT_ABGR8888);
+		if (!bench.hud_surface) return;
+	}
+
+	SDL_FillRect(bench.hud_surface, NULL, 0);
+	SDL_Rect bar_rc = { 0, 0, sw, bar_h };
+	SDL_FillRect(bench.hud_surface, &bar_rc, SDL_MapRGBA(bench.hud_surface->format, 10, 12, 18, 195));
+
+	double progress = 0.0;
+	char line1[256];
+	char line2[256];
+	const char *mode_tag = bench.genstate
+		? (bench.capture_frame > 0 ? "GENSTATE" : "FIND FRAME")
+		: (bench.config_mode ? "CONFIG" : (bench.recording ? "REC" : (bench.uncapped ? "UNCAPPED" : "PACED")));
+
+	if (bench.genstate) {
+		snprintf(line1, sizeof(line1), "[%s] %s", mode_tag, bench.label ? bench.label : "Generate Savestate");
+		if (bench.capture_frame > 0) {
+			progress = (double)bench.boot_frame / (double)bench.capture_frame;
+			if (progress > 1.0) progress = 1.0;
+			snprintf(line2, sizeof(line2),
+				"Auto-capturing frame %u/%u (%.0f%%) | Hold MENU: Abort",
+				bench.boot_frame, bench.capture_frame, progress * 100.0);
+		}
+		else {
+			progress = bench.uncapped ? 1.0 : 0.0;
+			snprintf(line2, sizeof(line2),
+				"Frame: %u | Hold R1: FF | Tap A: Save State | Hold MENU: Cancel",
+				bench.boot_frame);
+		}
+	}
+	else if (bench.phase == BENCH_PHASE_BOOT) {
+		snprintf(line1, sizeof(line1), "[%s] %s", mode_tag, bench.label ? bench.label : "N64 Benchmark");
+		snprintf(line2, sizeof(line2), "Initializing core & loading savestate...");
+	}
+	else if (bench.phase == BENCH_PHASE_WARMUP) {
+		progress = bench.warmup_frames > 0 ? (double)bench.phase_frames / (double)bench.warmup_frames : 1.0;
+		snprintf(line1, sizeof(line1), "[%s · WARMUP] %s", mode_tag, bench.label ? bench.label : "N64 Benchmark");
+		if (bench.recording) {
+			uint32_t rem = (bench.warmup_frames > bench.phase_frames)
+				? (bench.warmup_frames - bench.phase_frames)
+				: 0;
+			snprintf(line2, sizeof(line2), "REC WARMUP — GET READY (%uf)", rem);
+		}
+		else {
+			snprintf(line2, sizeof(line2), "Warming shaders %u/%u frames... (hold MENU to cancel)",
+				bench.phase_frames, bench.warmup_frames);
+		}
+	}
+	else {
+		double elapsed_s = (double)(getMicroseconds() - bench.record_start_us) / 1e6;
+		if (elapsed_s < 0.001) elapsed_s = 0.001;
+		progress = bench.duration_sec > 0.0 ? elapsed_s / bench.duration_sec : 1.0;
+		if (progress > 1.0) progress = 1.0;
+
+		snprintf(line1, sizeof(line1), "[%s] %s", mode_tag, bench.label ? bench.label : "N64 Benchmark");
+		if (bench.config_mode) {
+			progress = 1.0 - (elapsed_s / BENCH_CONFIG_HUD_SEC);
+			if (progress < 0.0) progress = 0.0;
+			snprintf(line2, sizeof(line2),
+				"CONFIG CONTROLS — Press MENU > Controls to remap & save, then Quit");
+		}
+		else if (bench.recording) {
+			snprintf(line2, sizeof(line2),
+				"REC %.0fs/%.0fs | %uf | Hold MENU to save",
+				elapsed_s, bench.duration_sec, bench.script_frame);
+		}
+		else {
+			double vi_fps = (double)bench.vi_frames / elapsed_s;
+			double ren_fps = (double)bench.rendered_frames / elapsed_s;
+			double avg_ms = bench.vi_frames > 0 ? (elapsed_s * 1000.0) / (double)bench.vi_frames : 0.0;
+			double temp_c = bench_read_soc_temp_c();
+
+			if (temp_c > 0.0) {
+				snprintf(line2, sizeof(line2),
+					"VI: %.1f fps | 3D: %.1f fps | %.1f ms | %.0fs/%.0fs | %.0fC | Hold MENU: Stop",
+					vi_fps, ren_fps, avg_ms, elapsed_s, bench.duration_sec, temp_c);
+			}
+			else {
+				snprintf(line2, sizeof(line2),
+					"VI: %.1f fps | 3D: %.1f fps | %.1f ms | %.0fs/%.0fs | Hold MENU: Stop",
+					vi_fps, ren_fps, avg_ms, elapsed_s, bench.duration_sec);
+			}
+		}
+	}
+
+	SDL_Color white = { 245, 248, 255, 255 };
+	SDL_Color accent = bench.uncapped
+		? (SDL_Color){ 255, 208, 96, 255 }
+		: (SDL_Color){ 126, 232, 160, 255 };
+
+	int pad_x = 10;
+	bench_blit_text(bench.hud_surface, font.tiny, line1, pad_x, 2, white);
+	bench_blit_text(bench.hud_surface, font.tiny, line2, pad_x, bar_h / 2 - 2, accent);
+
+	int pb_h = BENCH_HUD_PROGRESS_H;
+	SDL_Rect pb_bg = { 0, bar_h - pb_h, sw, pb_h };
+	SDL_FillRect(bench.hud_surface, &pb_bg, SDL_MapRGBA(bench.hud_surface->format, 45, 50, 62, 255));
+	int fill_w = (int)((double)sw * progress);
+	if (fill_w > 0) {
+		SDL_Rect pb_fg = { 0, bar_h - pb_h, fill_w, pb_h };
+		SDL_FillRect(bench.hud_surface, &pb_fg,
+			SDL_MapRGBA(bench.hud_surface->format, accent.r, accent.g, accent.b, 255));
+	}
+
+	PLAT_setNotificationSurface(bench.hud_surface, 0, 0);
+}
+
+static void bench_write_json_str(FILE *fp, const char *s) {
+	fputc('"', fp);
+	if (s) {
+		for (const unsigned char *p = (const unsigned char *)s; *p; p++) {
+			unsigned char c = *p;
+			if (c == '"') fputs("\\\"", fp);
+			else if (c == '\\') fputs("\\\\", fp);
+			else if (c == '\n') fputs("\\n", fp);
+			else if (c == '\r') fputs("\\r", fp);
+			else if (c == '\t') fputs("\\t", fp);
+			else if (c < 0x20) fprintf(fp, "\\u%04x", (unsigned)c);
+			else fputc(c, fp);
+		}
+	}
+	fputc('"', fp);
+}
