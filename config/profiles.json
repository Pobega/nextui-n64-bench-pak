  "tiers": [
    {
      "id": "quick-240p",
      "name": "Quick 320x240 (5 Profiles)",
      "description": "Compare ReARMed (gles2n64, Rice, Glide64) vs ParaLLEl-N64 (Rice, Glide64) at native 320x240.",
