        "rearmed-gles2n64-240p",
        "rearmed-rice-240p",
        "rearmed-glide64-240p",
        "parallel-rice-240p",
        "parallel-glide64-240p"
      ]
    },
    {
      "id": "hires-480p",
      "name": "Hi-Res 640x480 (5 Profiles)",
      "description": "Compare ReARMed and ParaLLEl-N64 across all renderers at 640x480.",
